#!/usr/bin/env node
import { installPlugin, runUpdate, UpdateError } from "./updater.js";
import { listResources } from "./ecc-runtime.js";
import { runUpstream } from "./upstream-sync.js";

const USAGE = `Usage:
  ./useful-skills install [--scope user|project] [--profile PROFILE]
  ./useful-skills update check|install [--profile PROFILE]
  ./useful-skills upstream check|sync [ref]

Requires Node.js 22+ and OMP with marketplace support.
Install bundles the OMP extension, skills, commands, agents, and rules; restart OMP to discover them.
Inside OMP: /ecc, /useful-skills, or /skill:ship-backlog-item
GitHub access for ship-backlog-item requires an authenticated gh CLI.
Source checkouts: git pull --ff-only. Use ./useful-skills upstream sync [ref]
from a clean development checkout to merge ECC source changes; marketplace plugin updates remain separate.

function usage(stream = process.stdout) {
  stream.write(`${USAGE}\n`);
}

function renderResources(kind, resources, query) {
  if (resources.length === 0) return `No ${kind} match${query ? `ing ${JSON.stringify(query)}` : ""}.`;
  return [
    `ECC ${kind} (${resources.length}):`,
    ...resources.flatMap((resource) => [
      `  ${resource.name}${resource.description ? ` — ${resource.description}` : ""}`,
      `    Use ${resource.usage ?? resource.path}`,
    ]),
  ].join("\n");
}

async function listCommand(argv) {
  const kind = argv[0] || "skills";
  if (!["skills", "commands", "agents", "rules"].includes(kind)) {
    throw new UpdateError("List kind must be skills, commands, agents, or rules.");
  }
  const query = argv.slice(1).join(" ").trim();
  const resources = await listResources(kind, { query });
  console.log(renderResources(kind, resources, query));
}

async function upstreamCommand(argv) {
  const [action, ref, ...extra] = argv;
  if (!["check", "sync"].includes(action) || extra.length > 0) {
    throw new UpdateError("Expected upstream check|sync [ref].");
  }
  const report = await runUpstream(action, ref ? { ref } : undefined);
  console.log(report.message);
}

/*
 * Keep option parsing separate from resource discovery so update/install
 * behavior remains identical for marketplace users.
 */
function optionValue(argv, index, name) {
  const value = argv[index + 1];
  if (!value || value.startsWith("--")) throw new UpdateError(`${name} requires a value.`);
  return value;
}

function parseOptions(argv, allowed) {
  const options = {};
  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index];
    if (argument === "--profile" || argument === "--scope") {
      if (!allowed.has(argument)) throw new UpdateError(`${argument} is not valid for this command.`);
      options[argument.slice(2)] = optionValue(argv, index, argument);
      index += 1;
      continue;
    }
    throw new UpdateError(`Unknown argument: ${argument}`);
  }
  return options;
}

export async function main(argv = process.argv.slice(2)) {
  try {
    if (argv.length === 1 && (argv[0] === "help" || argv[0] === "--help" || argv[0] === "-h")) {
      usage();
      return 0;
    }

    if (argv[0] === "list") {
      await listCommand(argv.slice(1));
      return 0;
    }

    if (argv[0] === "upstream") {
      await upstreamCommand(argv.slice(1));
      return 0;
    }

    if (argv[0] === "install") {
      const options = parseOptions(argv.slice(1), new Set(["--scope", "--profile"]));
      console.log((await installPlugin(options)).message);
      return 0;
    }

    if (argv[0] === "update" && (argv[1] === "check" || argv[1] === "install")) {
      const options = parseOptions(argv.slice(2), new Set(["--profile"]));
      const report = await runUpdate(argv[1], options);
      if (report.updated) console.log(report.message);
      else if (report.updateAvailable) {
        console.log(`Update available: ${report.currentVersion} → ${report.latestVersion}.\nRun ./useful-skills update install.`);
      } else console.log(`Useful Skills ${report.currentVersion}: ${report.message || "No newer stable release available."}`);
      return 0;
    }

    throw new UpdateError("Expected install, list, update check, update install, upstream check, upstream sync, or help.");
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    process.stderr.write(`useful-skills: ${message.replace(/[\u0000-\u001f\u007f]/g, " ")}\n`);
    usage(process.stderr);
    return 2;
  }
}

if (import.meta.url === new URL(process.argv[1], "file:").href) {
  process.exitCode = await main();
}
