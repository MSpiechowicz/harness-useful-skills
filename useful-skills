#!/usr/bin/env node
import { realpathSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { formatDoctor } from "./doctor.js";
import { PLUGIN_NAME } from "./names.js";
import { installPlugin, PACKAGE_ROOT, runUpdate, UpdateError } from "./updater.js";
import { formatResources, listResources, parseCatalogArguments, resourceInventory, safetyEnabled } from "./resources.js";
const USAGE = `Usage:
  ./useful-skills install [--scope user|project] [--profile PROFILE]
  ./useful-skills update check|install [--profile PROFILE]
  ./useful-skills list [query]
  ./useful-skills doctor
  ./useful-skills install --host opencode [--scope user|project]
  ./useful-skills update check|install --host opencode [--scope user|project]
  ./useful-skills uninstall --host opencode [--scope user|project]
  ./useful-skills doctor --host opencode [--scope user|project]
  ./useful-skills install --host codex [--local]
  ./useful-skills update --host codex
  ./useful-skills uninstall --host codex
  ./useful-skills doctor --host codex
  ./useful-skills models apply --host codex

Requires Node.js 22+ and OMP with marketplace support.
--host omp is the default; --host opencode installs into OpenCode instead (restart OpenCode afterwards).
--host codex installs into Codex (CODEX_HOME, default ~/.codex) and needs the codex command on PATH;
--local adds this directory as the marketplace instead of the GitHub release (restart Codex afterwards).
models apply --host codex writes the roles of $CODEX_HOME/harness-useful-skills/models.yml into the Codex agents (the installer does it too).
Owned us-* skills are selected by description or /skill:us-<name>.
No startup workflow.
Development uses one plan approval; publication requires an explicit request.
Graphify setup is lazy on the agent's us_memory build/query, not installation.
Load the package directory (omp -e .), not extension.js alone.
Source checkouts: git pull --ff-only. Marketplace updates require restart.`;

function usage(stream = process.stdout) {
  stream.write(`${USAGE}\n`);
}

async function listCommand(argv) {
  const { kind, query } = parseCatalogArguments(argv);
  const resources = await listResources(kind, { query });
  console.log(formatResources(kind, resources, query));
}

async function doctor() {
  const core = await resourceInventory();
  console.log(formatDoctor({ core, safety: safetyEnabled() }));
}

/*
 * Keep option parsing separate from resource discovery so update/install
 * behavior remains identical for marketplace users.
 */
function optionValue(argv, index, name) {
  const value = argv[index + 1];
  if (!value || value.startsWith("--")) {
    throw new UpdateError(`${name} requires a value.`);
  }
  return value;
}

function parseOptions(argv, allowed) {
  const options = {};
  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index];
    if (argument === "--profile" || argument === "--scope") {
      if (!allowed.has(argument)) {
        throw new UpdateError(`${argument} is not valid for this command.`);
      }
      options[argument.slice(2)] = optionValue(argv, index, argument);
      index += 1;
      continue;
    }
    throw new UpdateError(`Unknown argument: ${argument}`);
  }
  return options;
}

/** Commands that accept `--host`; `list` and `help` are host-agnostic. */
const HOSTED_COMMANDS = new Set(["install", "update", "uninstall", "doctor", "models"]);
const OMP_UNINSTALL = "uninstall needs --host opencode or --host codex; for OMP run `omp plugin uninstall harness-useful-skills@harness-useful-skills`.";
const HOSTS = new Set(["omp", "opencode", "codex"]);
const CODEX_UPDATE = "Useful Skills for Codex updates by installing again: re-run install.sh (or install.ps1) with HARNESS_SKILLS_HOST=codex, or run `./useful-skills install --host codex` from an updated checkout.";

/** Remove `--host VALUE` from the arguments; an omitted host means OMP. */
function splitHost(argv) {
  const index = argv.indexOf("--host");
  if (index === -1) {
    return { host: "omp", rest: argv };
  }

  const host = optionValue(argv, index, "--host");
  if (!HOSTS.has(host)) {
    throw new UpdateError("--host must be omp, opencode or codex.");
  }

  const rest = [...argv.slice(0, index), ...argv.slice(index + 2)];
  if (rest.includes("--host")) {
    throw new UpdateError("--host may be given only once.");
  }
  return { host, rest };
}

function openCodeScope(argv) {
  if (argv.includes("--profile")) {
    throw new UpdateError("--profile is an OMP option; it cannot be combined with --host opencode.");
  }

  const { scope } = parseOptions(argv, new Set(["--scope"]));
  if (scope !== undefined && scope !== "user" && scope !== "project") {
    throw new UpdateError("--scope must be user or project.");
  }
  return scope;
}

/** Validate an OpenCode command line, returning the operation to run; argument errors throw before anything runs. */
function openCodeOperation(command, argv) {
  if (command === "update") {
    const [action, ...rest] = argv;
    if (action !== "check" && action !== "install") {
      throw new UpdateError("Expected update check or update install.");
    }
    return { command, action, scope: openCodeScope(rest) ?? "user" };
  }

  return { command, scope: openCodeScope(argv) };
}

/** Check or install an update for the runtime installed in `scope`, never for this checkout. */
async function openCodeUpdate({ action, scope }, context) {
  const { runtimeInstall, scopeRootFor } = await import("./opencode/paths.js");
  const runtimeRoot = path.join(scopeRootFor({ scope, ...context }), "plugins", PLUGIN_NAME);
  if (!runtimeInstall(runtimeRoot)) {
    const flag = scope === "project" ? " --scope project" : "";
    throw new Error(`Useful Skills is not installed for OpenCode in ${scope} scope; run ./useful-skills install --host opencode${flag} first.`);
  }

  const { checkOpenCodeUpdate, installOpenCodeUpdate } = await import("./opencode/updater.js");
  const run = action === "check" ? checkOpenCodeUpdate : installOpenCodeUpdate;
  return (await run({ environment: context.environment, runtimeRoot })).message;
}

async function openCodeDoctor({ scope }, context) {
  const { inspectOpenCodeInstall } = await import("./opencode/install-status.js");
  const scopes = scope === "project" ? ["user", "project"] : ["user"];
  return scopes.map(each => inspectOpenCodeInstall({ scope: each, ...context }).text).join("\n\n");
}

async function runOpenCode(operation) {
  const context = { cwd: process.cwd(), environment: process.env };
  if (operation.command === "install") {
    const { installOpenCode } = await import("./opencode/install.js");
    const bundleRoot = path.join(PACKAGE_ROOT, "plugins", "opencode");
    return installOpenCode({ scope: operation.scope ?? "user", ...context, bundleRoot }).message;
  }

  if (operation.command === "uninstall") {
    const { uninstallOpenCode } = await import("./opencode/uninstall.js");
    return uninstallOpenCode({ scope: operation.scope ?? "user", ...context }).message;
  }

  if (operation.command === "update") {
    return openCodeUpdate(operation, context);
  }

  return openCodeDoctor(operation, context);
}

/**
 * Argument errors exit 2 with usage; a failed OpenCode operation exits 1 with its multi-line reason intact.
 * Success and error output both pass the one sanitizer (newlines kept) because paths in them come from disk.
 */
async function openCodeCommand(command, argv) {
  const operation = openCodeOperation(command, argv);
  const { printableText } = await import("./opencode/paths.js");
  try {
    console.log(printableText(await runOpenCode(operation)));
    return 0;
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    process.stderr.write(`useful-skills: ${printableText(message)}\n`);
    return 1;
  }
}

/** Validate `models apply`: only Codex needs it, because Claude and OpenCode apply their model roles when a session starts. */
function modelsOperation(host, argv) {
  if (host !== "codex") {
    throw new UpdateError("models apply is for --host codex; Claude Code and OpenCode apply their model roles when a session starts.");
  }

  if (argv.length !== 1 || argv[0] !== "apply") {
    throw new UpdateError("Expected models apply --host codex.");
  }
  return { command: "models" };
}

/** Validate a Codex command line, returning the operation to run; argument errors throw before anything runs. */
function codexOperation(command, argv) {
  for (const option of ["--profile", "--scope"]) {
    if (argv.includes(option)) {
      throw new UpdateError(`${option} is not valid with --host codex; Codex installs into CODEX_HOME.`);
    }
  }

  if (command === "update") {
    const [action, ...rest] = argv;
    if ((action !== undefined && action !== "check" && action !== "install") || rest.length > 0) {
      throw new UpdateError("Expected update --host codex.");
    }
    return { command };
  }

  const local = argv.filter(argument => argument === "--local").length;
  if (local > 0 && command !== "install") {
    throw new UpdateError("--local is valid only with install --host codex.");
  }

  const unknown = argv.find(argument => argument !== "--local");
  if (unknown !== undefined) {
    throw new UpdateError(`Unknown argument: ${unknown}`);
  }

  if (local > 1) {
    throw new UpdateError("--local may be given only once.");
  }
  return { command, local: local === 1 };
}

async function runCodex({ command, local }) {
  if (command === "models") {
    const { applyCodexModels, formatApplied } = await import("./codex/apply-models.js");
    return formatApplied(await applyCodexModels({ environment: process.env }));
  }

  if (command === "install") {
    const { installCodex } = await import("./codex/install.js");
    return (await installCodex({ environment: process.env, packageRoot: PACKAGE_ROOT, local })).message;
  }

  if (command === "uninstall") {
    const { uninstallCodex } = await import("./codex/uninstall.js");
    return uninstallCodex({ environment: process.env }).message;
  }

  if (command === "update") {
    return CODEX_UPDATE;
  }

  const { inspectCodexInstall } = await import("./codex/install-status.js");
  return inspectCodexInstall({ environment: process.env }).text;
}

/** Like openCodeCommand: argument errors exit 2 with usage, a failed operation exits 1 with its reason. */
async function codexCommand(command, argv) {
  const operation = command === "models" ? modelsOperation("codex", argv) : codexOperation(command, argv);
  const { printableText } = await import("./opencode/paths.js");
  try {
    console.log(printableText(await runCodex(operation)));
    return 0;
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    process.stderr.write(`useful-skills: ${printableText(message)}\n`);
    return 1;
  }
}

export async function main(argv = process.argv.slice(2)) {
  try {
    if (argv.length === 1 && (argv[0] === "help" || argv[0] === "--help" || argv[0] === "-h")) {
      usage();
      return 0;
    }

    if (argv[0] === "list") {
      await listCommand(argv);
      return 0;
    }

    if (HOSTED_COMMANDS.has(argv[0])) {
      const { host, rest } = splitHost(argv.slice(1));
      if (argv[0] === "models" && host !== "codex") {
        modelsOperation(host, rest);
      }
      if (host === "opencode") {
        return await openCodeCommand(argv[0], rest);
      }
      if (host === "codex") {
        return await codexCommand(argv[0], rest);
      }
      argv = [argv[0], ...rest];
    }

    if (argv.length === 1 && argv[0] === "doctor") {
      await doctor();
      return 0;
    }

    if (argv[0] === "install") {
      const options = parseOptions(argv.slice(1), new Set(["--scope", "--profile"]));
      console.log((await installPlugin(options)).message);
      return 0;
    }

    if (argv[0] === "update" && (argv[1] === "check" || argv[1] === "install")) {
      const options = parseOptions(argv.slice(2), new Set(["--profile"]));
      const report = await runUpdate(argv[1], options);
      if (report.updated) {
        console.log(report.message);
      } else if (report.updateAvailable) {
        console.log(`Update available: ${report.currentVersion} → ${report.latestVersion}.\nRun ./useful-skills update install.`);
      } else {
        console.log(`Useful Skills ${report.currentVersion}: ${report.message || "No newer stable release available."}`);
      }
      return 0;
    }

    if (argv[0] === "uninstall") {
      throw new UpdateError(OMP_UNINSTALL);
    }

    throw new UpdateError("Expected install, list, doctor, update check, update install, or help.");
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    process.stderr.write(`useful-skills: ${message.replace(/[\u0000-\u001f\u007f]/g, " ")}\n`);
    usage(process.stderr);
    return 2;
  }
}

/** Run main for direct and symlinked invocations (npm bin links), but not when imported. */
function invokedDirectly() {
  if (!process.argv[1]) {
    return false;
  }

  const self = fileURLToPath(import.meta.url);
  try {
    return realpathSync(process.argv[1]) === realpathSync(self);
  } catch {
    return process.argv[1] === self;
  }
}

if (invokedDirectly()) {
  process.exitCode = await main();
}
