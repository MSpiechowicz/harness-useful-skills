#!/usr/bin/env node
import { installPlugin, runUpdate, UpdateError } from "./updater.js";
import { formatResources, listResources, parseCatalogArguments, resourceInventory, safetyEnabled } from "./resources.js";

const USAGE = `Usage:
  ./useful-skills install [--scope user|project] [--profile PROFILE]
  ./useful-skills update check|install [--profile PROFILE]
  ./useful-skills list [query]
  ./useful-skills library list [skills|commands|agents|rules] [query]
  ./useful-skills doctor

Requires Node.js 22+ and OMP with marketplace support.
Owned us-* skills are selected by description or /skill:us-<name>.
ECC is opt-in reference material; no Anvil dependency or startup workflow.
Development uses one plan approval; publication requires an explicit request.
Graphify setup is lazy on the agent's us_memory build/query, not installation.
Load the package directory (omp -e .), not extension.js alone.
Source checkouts: git pull --ff-only. Marketplace updates require restart.`;

function usage(stream = process.stdout) {
  stream.write(`${USAGE}\n`);
}

async function listCommand(argv) {
  const { kind, query, source } = parseCatalogArguments(argv);
  const resources = await listResources(kind, { query, source });
  console.log(formatResources(kind, resources, query, source));
}

async function doctor() {
  const [core, library] = await Promise.all([resourceInventory(), resourceInventory({ source: "library" })]);
  console.log([
    "Useful Skills — owned skills, optional library, Anvil-free",
    `Core: ${JSON.stringify(core)}`,
    `Library references: ${JSON.stringify(library)}`,
    `Safety guard: ${safetyEnabled() ? "enabled" : "disabled"}`,
    "Use /useful-skills doctor in OMP for current profile memory status.",
    "No dependencies installed or graphs built by this check.",
  ].join("\n"));
}

/*
 * Keep option parsing separate from resource discovery so update/install
 * behavior remains identical for marketplace users.
 */
function optionValue(argv, index, name) {
  const value = argv[index + 1];
  if (!value || value.startsWith("--")) throw new UpdateError(`${name} requires a value.`);
  return value;
}

function parseOptions(argv, allowed) {
  const options = {};
  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index];
    if (argument === "--profile" || argument === "--scope") {
      if (!allowed.has(argument)) throw new UpdateError(`${argument} is not valid for this command.`);
      options[argument.slice(2)] = optionValue(argv, index, argument);
      index += 1;
      continue;
    }
    throw new UpdateError(`Unknown argument: ${argument}`);
  }
  return options;
}

export async function main(argv = process.argv.slice(2)) {
  try {
    if (argv.length === 1 && (argv[0] === "help" || argv[0] === "--help" || argv[0] === "-h")) {
      usage();
      return 0;
    }

    if (argv[0] === "list" || argv[0] === "library") {
      await listCommand(argv);
      return 0;
    }

    if (argv.length === 1 && argv[0] === "doctor") {
      await doctor();
      return 0;
    }

    if (argv[0] === "install") {
      const options = parseOptions(argv.slice(1), new Set(["--scope", "--profile"]));
      console.log((await installPlugin(options)).message);
      return 0;
    }

    if (argv[0] === "update" && (argv[1] === "check" || argv[1] === "install")) {
      const options = parseOptions(argv.slice(2), new Set(["--profile"]));
      const report = await runUpdate(argv[1], options);
      if (report.updated) console.log(report.message);
      else if (report.updateAvailable) {
        console.log(`Update available: ${report.currentVersion} → ${report.latestVersion}.\nRun ./useful-skills update install.`);
      } else console.log(`Useful Skills ${report.currentVersion}: ${report.message || "No newer stable release available."}`);
      return 0;
    }

    throw new UpdateError("Expected install, list, library list, doctor, update check, update install, or help.");
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    process.stderr.write(`useful-skills: ${message.replace(/[\u0000-\u001f\u007f]/g, " ")}\n`);
    usage(process.stderr);
    return 2;
  }
}

if (import.meta.url === new URL(process.argv[1], "file:").href) {
  process.exitCode = await main();
}
