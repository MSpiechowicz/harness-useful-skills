{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/claude/hooks.js", "UserPromptSubmit"]
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "useful-skills:us-ignore-workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/claude/hooks.js", "UserPromptExpansion"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/claude/hooks.js", "PreToolUse"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/claude/hooks.js", "PostToolUse"]
          }
        ]
      }
    ]
  }
}
